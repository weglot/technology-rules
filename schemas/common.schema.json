{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "defs": {
    "PluginName": {
      "title": "Plugin Name",
      "description": "The name of the plugin. It's only used for reporting and analytics",
      "type": "string",
      "default": "Change me!"
    },
    "ExamplesURL": {
      "title": "Example URL",
      "description": "Provide examples URL to the resource you want to translate, if possible",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Type": {
      "title": "Resource type",
      "description": "What kind of page(s) do you want the rule to apply to?",
      "type": "string",
      "default": "HTML",
      "oneOf": [
        {
          "const": "HTML",
          "title": "HTML"
        },
        {
          "const": "JSON",
          "title": "JSON"
        },
        {
          "const": "XML",
          "title": "XML"
        },
        {
          "const": "RAW",
          "title": "RAW (.js, .txt)"
        }
      ]
    },
    "TechnologyID": {
      "description": "A Weglot Technology ID",
      "type": "integer",
      "oneOf": [
        { "const": 1, "title": "WordPress" },
        { "const": 2, "title": "Shopify" },
        { "const": 3, "title": "BigCommerce" },
        { "const": 4, "title": "Jimdo" },
        { "const": 5, "title": "Squarespace" },
        { "const": 6, "title": "Wix" },
        { "const": 7, "title": "Laravel" },
        { "const": 8, "title": "Symfony" },
        { "const": 9, "title": "Weebly" },
        { "const": 10, "title": "Drupal" },
        { "const": 11, "title": "OctoberCMS" },
        { "const": 12, "title": "Other" },
        { "const": 13, "title": "Webflow" },
        { "const": 14, "title": "Prestashop" },
        { "const": 15, "title": "Magento" },
        { "const": 16, "title": "Square Online" },
        { "const": 17, "title": "Bubble" },
        { "const": 18, "title": "Salesforce" },
        { "const": 19, "title": "LearnWorlds" },
        { "const": 20, "title": "Booqable" },
        { "const": 21, "title": "Carrd" },
        { "const": 22, "title": "DealerOn" },
        { "const": 23, "title": "CraftCMS" },
        { "const": 24, "title": "Lovable" },
        { "const": 25, "title": "Framer" }
      ]
    },
    "BodyReplacement": {
      "type": "object",
      "properties": {
        "regex": {
          "type": "string",
          "description": "Everything should be captured. The second capture group should be the host to replace"
        },
        "slash": {
          "type": "string",
          "default": "/",
          "enum": ["/", "\\/"],
          "description": "The slash character in that context. Sometimes, the slash character needs to be escaped"
        }
      }
    }
  }
}
