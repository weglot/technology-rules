{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "defs": {
    "PluginName": {
      "title": "Plugin Name",
      "description": "The name of the plugin. It's only used for reporting and analytics",
      "type": "string",
      "default": "Change me!"
    },
    "ExamplesURL": {
      "title": "Example URL",
      "description": "Provide examples URL to the resource you want to translate, if possible",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Type": {
      "title": "Resource type",
      "description": "What kind of page(s) do you want the rule to apply to?",
      "type": "string",
      "default": "HTML",
      "oneOf": [
        {
          "const": "HTML",
          "title": "HTML"
        },
        {
          "const": "JSON",
          "title": "JSON"
        },
        {
          "const": "XML",
          "title": "XML"
        },
        {
          "const": "RAW",
          "title": "RAW (.js, .txt)"
        }
      ]
    },
    "Technology": {
      "description": "A Weglot Technology",
      "type": "string",
      "oneOf": [
        { "const": "WordPress" },
        { "const": "Shopify" },
        { "const": "BigCommerce" },
        { "const": "Jimdo" },
        { "const": "Squarespace" },
        { "const": "Wix" },
        { "const": "Laravel" },
        { "const": "Symfony" },
        { "const": "Weebly" },
        { "const": "Drupal" },
        { "const": "OctoberCMS" },
        { "const": "Other" },
        { "const": "Webflow" },
        { "const": "Prestashop" },
        { "const": "Magento" },
        { "const": "Square Online" },
        { "const": "Bubble" },
        { "const": "Salesforce" },
        { "const": "LearnWorlds" },
        { "const": "Booqable" },
        { "const": "Carrd" },
        { "const": "DealerOn" },
        { "const": "CraftCMS" },
        { "const": "Lovable" },
        { "const": "Framer" }
      ]
    },
    "BodyReplacement": {
      "type": "object",
      "properties": {
        "regex": {
          "type": "string",
          "description": "Everything should be captured. The second capture group should be the host to replace"
        },
        "slash": {
          "type": "string",
          "default": "/",
          "enum": ["/", "\\/"],
          "description": "The slash character in that context. Sometimes, the slash character needs to be escaped"
        }
      }
    }
  }
}
